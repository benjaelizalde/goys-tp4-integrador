# Configuración de API de Groq para el Agente AIOps / SecOps
GROQ_API_KEY=tu_api_key_de_groq_aqui

# Modelo recomendado: qwen/qwen3.8-27b (latencia < 200ms y soporte JSON nativo)
GROQ_MODEL=qwen/qwen3.8-27b

# Notificaciones Telegram (opcionales; si se dejan vacías el sistema opera sin enviar mensajes)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
